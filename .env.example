# ==========================================
# 1. СЕРВЕР И БАЗА ДАННЫХ (POSTGRESQL & SECURITY)
# ==========================================
BASE_URL=http://127.0.0.1:8000
SECRET_KEY=your_super_secret_jwt_key_here

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=konsyltant
DATABASE_URL=postgresql://user:password@db:5432/konsyltant


# ==========================================
# 2. GIGACHAT API (Сбер ИИ)
# ==========================================
GIGACHAT_CREDENTIALS=your_gigachat_credentials_base64_here
GIGACHAT_AUTH_KEY=your_gigachat_credentials_base64_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS


# ==========================================
# 3. ЯНДЕКС.ДИСК И YANDEX SMTP
# ==========================================
YANDEX_DISK_TOKEN=your_yandex_disk_oauth_token_here
YANDEX_EMAIL=your_email@yandex.ru

# Yandex SMTP Settings
SMTP_SERVER=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your_email@yandex.ru
SMTP_PASSWORD=your_yandex_app_password_here


# ==========================================
# 4. UNISENDER & EMAIL CONFIGURATION
# ==========================================
DEFAULT_NOTIFICATION_EMAIL=your_email@yandex.ru
UNISENDER_API_KEY=your_unisender_api_key_optional
