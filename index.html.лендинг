            padding: 12px;
            border-radius: 16px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-size: 0.95rem;
            transition: var(--transition-bounce);
            text-align: center;
            box-shadow: 0 4px 0px rgba(0,0,0,0.15);
        }

        .telegram-btn {
            background: #0EA5E9;
            color: white;
            box-shadow: 0 4px 0px #0369A1;
        }
        .telegram-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 0px #0369A1;
        }
        .telegram-btn:active {
            transform: translateY(2px);
            box-shadow: 0 0px 0px #0369A1;
        }

        .whatsapp-btn {
            background: #22C55E;
