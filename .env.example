# ==========================================
# 1. СЕРВЕР И БАЗА ДАННЫХ (POSTGRESQL & SECURITY)
# ==========================================
# [SECURITY] JWT Stateless Sessions (Генерация ключа: openssl rand -hex 32)
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SECRET_KEY=your_super_secret_jwt_key_here

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=konsyltant
DATABASE_URL=postgresql://user:password@db:5432/konsyltant


# ==========================================
# 2. GIGACHAT API (Сбер ИИ)
# ==========================================
GIGACHAT_CREDENTIALS=your_gigachat_credentials_base64_here
GIGACHAT_AUTH_KEY=your_gigachat_credentials_base64_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_PACKAGE_TOKENS_LIMIT=1000000


# Yandex Disk Settings
YANDEX_DISK_TOKEN=your_yandex_disk_oauth_token_here
YANDEX_EMAIL=your_email@yandex.ru
EXCLUDED_FOLDERS=Загрузки,Trash,Archive,Корзина

# Yandex SMTP Settings
SMTP_SERVER=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your_email@yandex.ru
SMTP_PASSWORD=your_yandex_app_password_here


# ==========================================
# 4. UNISENDER & EMAIL CONFIGURATION
# ==========================================
DEFAULT_NOTIFICATION_EMAIL=your_email@yandex.ru
UNISENDER_API_KEY=your_unisender_api_key_optional

# [SECURITY] Fernet ключ для шифрования Data at Rest (Медицинские данные, чаты)
# Для генерации ключа можно запустить: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode('utf-8'))"
ENCRYPTION_KEY=your_fernet_key_here


# ==========================================
# 5. SSL & NGINX DOMAINS
# ==========================================
SSL_DOMAINS=цмз.site,xn--g1aj3a.site,www.xn--g1aj3a.site
LETSENCRYPT_EMAIL=your_email@example.com

